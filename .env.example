# Copy to .env locally — never commit secrets.
# Featherless (OpenAI-compatible) mutation model

MUTINY_FEATHERLESS_API_KEY=
MUTINY_FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
MUTINY_MUTATION_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
MUTINY_LLM_TIMEOUT=30
MUTINY_LLM_TEMPERATURE=0.7

# Demo pin (see config/demo_pin.json). Smoke gate uses template fallback when
# MUTINY_FEATHERLESS_API_KEY is empty — that is the default Iris reliability path.
