# Copy to .env locally — never commit secrets.
# Featherless (OpenAI-compatible) mutation model, separate from the target agent.
# OPENAI_API_KEY alone configures the target, not the Featherless mutator.
# Set a dedicated mutation key here (FEATHERLESS_API_KEY is also accepted).

MUTINY_FEATHERLESS_API_KEY=
# Optional endpoint override; the default is https://api.featherless.ai/v1.
# Setting a non-empty URL explicitly also allows OPENAI_API_KEY as a fallback
# mutation credential. Only opt in when that key belongs to the chosen endpoint.
# MUTINY_FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
MUTINY_MUTATION_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# Timeout must be positive and finite; temperature non-negative and finite.
# Invalid numeric settings disable the mutator (template fallback; health stays up).
MUTINY_LLM_TIMEOUT=30
MUTINY_LLM_TEMPERATURE=0.7

# Demo pin (see config/demo_pin.json). Smoke gate uses template fallback when
# no mutation key is configured — that is the default Iris reliability path.
